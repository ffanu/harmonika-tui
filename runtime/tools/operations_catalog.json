    {
      "id": "operations.security.scan",
      "description": "Run configured Semgrep or Trivy against a registered project.",
      "engine": "operations",
      "status": "context_required",
      "execution_target": "shared_operations_backend",
      "access": [
        "api",
        "tui"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "scanner": {
            "type": "string",
            "enum": [
              "semgrep",
              "trivy"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "vuln",
              "misconfig",
              "secret"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 400
          },
          "project": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "scanner",
          "project"
        ],
        "additionalProperties": false
      },
      "requires_registered_project": true,
      "requires_deploy_permission": false,
      "limitations": [
        "Toolchain, project access and actual verification are checked at invocation."
      ]
    },
    {
      "id": "operations.browser.regression",
      "description": "Run real browser assertions and private traces on registered static HTML.",
      "engine": "operations",
      "status": "context_required",
      "execution_target": "shared_operations_backend",
      "access": [
        "api",
        "tui"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 400
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "click",
                    "fill",
                    "check",
                    "select",
                    "assert_visible",
                    "assert_text",
                    "assert_count",
                    "assert_value"
                  ]
                },
                "selector": {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "enum": [
                        "css",
                        "test_id",
                        "role"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "by",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "value": {
                  "type": "string",
                  "maxLength": 1000
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              },
              "required": [
                "action",
                "selector"
              ],
              "additionalProperties": false
            }
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 320,
                "maximum": 1920
              },
              "height": {
                "type": "integer",
                "minimum": 320,
                "maximum": 1080
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "project": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "required": [
          "path",
          "steps",
          "project"
        ],
        "additionalProperties": false
      },
      "requires_registered_project": true,
      "requires_deploy_permission": false,
      "limitations": [
        "Toolchain, project access and actual verification are checked at invocation."
      ]
    },
