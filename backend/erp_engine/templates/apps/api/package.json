{
  "name": "@harmonika/erp-api",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc && node -e \"require('fs').copyFileSync('src/core.cjs','dist/core.cjs')\"",
    "start": "node dist/main.js",
    "bootstrap": "node dist/bootstrap.js",
    "db:init": "prisma db push && node scripts/rls.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/jwt": "11.0.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "express": "5.3.0",
    "cookie-parser": "1.4.7",
    "@prisma/adapter-pg": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "@types/node": "22.18.6",
    "@types/express": "5.0.3",
    "@types/cookie-parser": "1.4.9"
  }
}
