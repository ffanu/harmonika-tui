diff --git a/packages/core/test/mcp-harmonika-ssh.test.ts b/packages/core/test/mcp-harmonika-ssh.test.ts
new file mode 100644
index 0000000000..5002ed72d0
--- /dev/null
+++ b/packages/core/test/mcp-harmonika-ssh.test.ts
@@ -0,0 +1,99 @@
+import { expect } from "bun:test"
+import { Effect, Exit, Layer, Stream } from "effect"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { Bus } from "@opencode/core/bus"
+import { Mcp } from "@opencode/core/mcp/index"
+import { Permission } from "@opencode/core/permission"
+import { Session } from "@opencode/core/session"
+import { Tool } from "@opencode/core/tool"
+import { McpTool } from "@opencode/core/tool/mcp"
+import { testEffect } from "./lib/effect"
+import { codeModeListings, toolIdentity } from "./lib/tool"
+
+for (const { preference, blocked } of [undefined, true, false].flatMap((preference) =>
+  [false, true].map((blocked) => ({ preference, blocked })),
+)) {
+  const calls: Parameters<Mcp.Interface["callTool"]>[0][] = []
+  const permissions: Permission.AssertInput[] = []
+  const source = (server: string, name: string): Mcp.Tool => ({
+    server: Mcp.ServerName.make(server),
+    name,
+    ...(server === "harmonika" ? { codemode: preference } : {}),
+    description: "Run fixture command",
+    inputSchema: { type: "object", properties: { command: { type: "string" } }, required: ["command"] },
+  })
+  const it = testEffect(
+    AppNodeBuilder.build(LayerNode.group([Tool.node, McpTool.node]), [
+      Mcp.node.replace(
+        Layer.mock(Mcp.Service, {
+          awaitStartup: () => Effect.void,
+          tools: () => Effect.succeed(sources),
+          callTool: (input) =>
+            Effect.sync(() => {
+              calls.push(input)
+              return { isError: false, content: [{ type: "text" as const, text: "done" }] }
+            }),
+        }),
+      ),
+      Permission.node.replace(
+        Layer.mock(Permission.Service, {
+          assert: (input) =>
+            Effect.gen(function* () {
+              permissions.push(input)
+              if (blocked)
+                return yield* new Permission.BlockedError({
+                  rules: [],
+                  permission: input.action,
+                  resources: ["*"],
+                  reason: "SSH disabled",
+                })
+            }),
+        }),
+      ),
+      Bus.node.replace(Layer.mock(Bus.Service, { subscribe: () => Stream.never })),
+    ]),
+  )
+  const sources = [
+    source("harmonika", "network_exec"),
+    source("harmonika", "image_generate"),
+    source("other", "network_exec"),
+  ]
+
+  it.effect(`SSH command quoting survives native tool routing (codemode=${preference}, blocked=${blocked})`, () =>
+    Effect.gen(function* () {
+      const registry = yield* Tool.Service
+      yield* (yield* McpTool.Service).flush
+      const snapshot = yield* registry.snapshot()
+      const names = snapshot.definitions.map((tool) => tool.name)
+      expect(names.includes("harmonika_network_exec")).toBe(preference !== true)
+      expect(names.includes("harmonika_image_generate")).toBe(preference === false)
+      expect(names).not.toContain("other_network_exec")
+      const catalog = codeModeListings(snapshot.codeModeCatalog!).map((entry) => entry.path)
+      expect(catalog.includes("harmonika.network_exec")).toBe(preference === true)
+      expect(catalog).toContain("other.network_exec")
+      const command =
+        "python3 - <<'PY'\nimport re\nassert re.fullmatch(r'\\d+', '123')\nprint(\"it's $HOME `literal` ${value}\")\nPY"
+      const input = { command }
+      const call =
+        preference === true
+          ? { name: "execute", input: { code: `return await tools.harmonika.network_exec(${JSON.stringify(input)})` } }
+          : { name: "harmonika_network_exec", input }
+      const sessionID = Session.ID.make("ses_ssh_quoting")
+      const result = yield* snapshot
+        .execute({ sessionID, ...toolIdentity, call: { type: "tool-call", id: "ssh_fixture", ...call } })
+        .pipe(Effect.exit)
+      if (blocked) {
+        expect(calls).toEqual([])
+        if (preference === true) {
+          expect(Exit.isSuccess(result) && result.value.output).toMatchObject({ toolCalls: [{ status: "error" }] })
+        } else expect(Exit.isFailure(result)).toBe(true)
+      } else {
+        expect(Exit.isSuccess(result)).toBe(true)
+        expect(calls).toEqual([{ server: "harmonika", name: "network_exec", args: input, sessionID }])
+      }
+      expect(permissions).toHaveLength(1)
+      expect(permissions[0].action).toBe("harmonika_network_exec")
+    }),
+  )
+}
