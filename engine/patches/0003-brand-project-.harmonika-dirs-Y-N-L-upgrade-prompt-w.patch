+
+/** Read the deferred-upgrade marker written by `harmonika upgrade` when the user picks Later. */
+function deferredUpgrade(): string | undefined {
+  try {
+    const file = path.join(path.dirname(process.execPath), ".harmonika-update-deferred")
+    const value = readFileSync(file, "utf8").trim()
+    return value || undefined
+  } catch {
+    return undefined
+  }
+}
