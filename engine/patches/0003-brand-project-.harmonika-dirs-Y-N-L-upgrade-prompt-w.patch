+
+/** Deferral marker so the next launch can ask again instead of silently staying stale. */
+const deferralPath = () => path.join(path.dirname(process.execPath), `.${Brand.cliName}-update-deferred`)
+
+function recordDeferral(version: string) {
+  try {
+    require("node:fs").writeFileSync(deferralPath(), `${version}\n`)
+  } catch {
+    // A read-only install directory must not break the command.
+  }
+}
+
+/**
+ * Ask Yes / No / Later. Non-interactive sessions (pipes, CI, `--auto`) proceed with the
+ * upgrade so automation never hangs waiting for stdin.
+ */
+const askDecision = Effect.fnUntraced(function* (target: string) {
+  if (!process.stdin.isTTY || process.env.HARMONIKA_UPGRADE_ASSUME_YES === "1") return "yes" as const
+  const answer = yield* Effect.promise(() =>
+    select<string>({
+      message: `Pembaruan ${Brand.product} ${OPENCODE_VERSION} → ${target}. Pilih tindakan:`,
+      initialValue: "yes",
+      options: [
+        { value: "yes", label: "[Y] Yes", hint: "pasang sekarang" },
+        { value: "no", label: "[N] No", hint: "lewati, tanpa pengingat" },
+        { value: "later", label: "[L] Later", hint: "ingatkan lagi saat harmonika dibuka" },
+      ],
+    }),
+  )
+  if (isCancel(answer)) return "no" as const
+  return answer === "yes" || answer === "later" ? (answer as "yes" | "later") : ("no" as const)
+})
