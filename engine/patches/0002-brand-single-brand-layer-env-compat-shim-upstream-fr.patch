+/**
+ * Single source of truth for Harmonika branding.
+ *
+ * The rebrand stays small on purpose: upstream internals keep their own names
+ * (package scopes, `OPENCODE_*` build defines), and every user-visible string,
+ * path and default flows through this module so a rebase to upstream never
+ * conflicts with dozens of scattered literals.
+ *
+ * Import as `@opencode/util/brand`.
+ */
+const PREFIX = "HARMONIKA"
+
+export const Brand = {
+  product: "Harmonika AI",
+  vendor: "Harmonika ID",
+  cliName: "harmonika",
+  version: "1.0.0",
+  channel: "stable",
+  artifact: "cli",
+  website: "https://harmonika.id",
+  docs: "https://harmonika.id/docs",
+  apiBase: "https://chat.harmonika.id/v1",
+  assetsBase: "https://chat.harmonika.id/assets/harmonika-terminal",
+  /** Directory name under XDG config/data/state. */
+  configDirName: "harmonika-terminal",
+  /** Config file names in priority order; upstream names stay readable for migration. */
+  configNames: ["config.json", "harmonika.json", "opencode.json", "opencode.jsonc"],
+  /** Per-project state directories; the second entry is read for backwards compatibility. */
+  projectDirs: [".harmonika", ".opencode"],
+  databaseName: "harmonika",
+  envPrefix: PREFIX,
+} as const
+
+/**
+ * Read a setting with Harmonika priority and an upstream fallback.
+ *
+ * `env("CONFIG_DIR")` resolves `HARMONIKA_CONFIG_DIR`, then `OPENCODE_CONFIG_DIR`.
+ * Nothing writes to the upstream name, so a shared environment stays predictable.
+ */
+export function env(name: string, fallback?: string): string | undefined {
+  return process.env[`${PREFIX}_${name}`] ?? process.env[`OPENCODE_${name}`] ?? fallback
+}
+
+/** Absolute upgrade manifest published by Harmonika ID. */
+export const UpdateManifestUrl = `${Brand.assetsBase}/engine/update.json`
+
+/** Installer published by Harmonika ID for engine binaries. */
+export const EngineInstallerUrl = `${Brand.assetsBase}/engine/install.sh`
\ No newline at end of file
